{
  "name": "developer_api_fhir_client_js",
  "version": "1.0.0",
  "description": "A comprehensive TypeScript SDK for OpenIMIS Developer API FHIR endpoints. Provides authentication, patient/employee management, and policy holder operations.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "require": "./lib/index.js",
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf lib",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "lint:fix": "tsc --noEmit --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run build",
    "start": "node lib/index.js",
    "dev": "ts-node src/index.ts"
  },
  "keywords": [
    "openimis",
    "fhir",
    "sdk",
    "healthcare",
    "api",
    "typescript",
    "policy-holder",
    "patient",
    "employee",
    "authentication",
    "healthcare-interoperability",
    "fhir-r4",
    "hl7-fhir"
  ],
  "author": {
    "name": "2MCorp",
    "url": "https://github.com/2MCorp"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2MCorp/developer_api_fhir_client_js.git"
  },
  "bugs": {
    "url": "https://github.com/2MCorp/developer_api_fhir_client_js/issues"
  },
  "homepage": "https://github.com/2MCorp/developer_api_fhir_client_js#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.test.ts",
      "!src/**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 10000
  }
}
