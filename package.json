{
  "name": "openimis-dev-api-sdk-js",
  "version": "1.0.0",
  "description": "TypeScript SDK for OpenIMIS Developer API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./portal": {
      "types": "./dist/portal/index.d.ts",
      "default": "./dist/portal/index.js"
    },
    "./portal/common": {
      "types": "./dist/portal/common/index.d.ts",
      "default": "./dist/portal/common/index.js"
    },
    "./portal/common/browser": {
      "types": "./dist/portal/common/browser.d.ts",
      "default": "./dist/portal/common/browser.js"
    },
    "./portal/server": {
      "types": "./dist/portal/common/server/index.d.ts",
      "default": "./dist/portal/common/server/index.js"
    },
    "./portal/client": {
      "types": "./dist/portal/common/client/index.d.ts",
      "default": "./dist/portal/common/client/index.js"
    },
    "./portal/sw": {
      "types": "./dist/portal/common/client/offline/service_worker.d.ts",
      "default": "./dist/portal/common/client/offline/service_worker.js"
    },
    "./portal/healthfacility": {
      "types": "./dist/portal/healthfacility/index.d.ts",
      "default": "./dist/portal/healthfacility/index.js"
    },
    "./portal/healthfacility/client": {
      "types": "./dist/portal/healthfacility/client.d.ts",
      "default": "./dist/portal/healthfacility/client.js"
    },
    "./portal/employer": {
      "types": "./dist/portal/employer/index.d.ts",
      "default": "./dist/portal/employer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "pnpm run build && pnpm pack",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@types/fhir": "^0.0.44",
    "dexie": "^4.4.7",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "fake-indexeddb": "^6.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
